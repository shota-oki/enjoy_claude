          <mxGeometry x="400" y="40" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="items" value="&lt;b&gt;items（アイテム）&lt;/b&gt;&lt;hr&gt;PK　id　：string&lt;br&gt;　　name　：string&lt;br&gt;FK　categoryId　：string&lt;br&gt;FK　subcategoryId　：string | null&lt;br&gt;FK　colorId　：string&lt;br&gt;　　brand　：string | null&lt;br&gt;　　size　：string | null&lt;br&gt;　　purchaseDate　：string | null&lt;br&gt;　　price　：number | null&lt;br&gt;　　shop　：string | null&lt;br&gt;　　seasons　：string[]&lt;br&gt;　　material　：string | null&lt;br&gt;　　washingMethod　：string | null&lt;br&gt;　　memo　：string | null&lt;br&gt;　　photoIds　：string[]&lt;br&gt;　　createdAt　：number&lt;br&gt;　　updatedAt　：number" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#2b5f8e;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="260" width="270" height="330" as="geometry" />
        </mxCell>
        <mxCell id="photos" value="&lt;b&gt;photos（写真）&lt;/b&gt;&lt;hr&gt;PK　id　：string&lt;br&gt;FK　itemId　：string&lt;br&gt;　　image　：Blob（JPEG）&lt;br&gt;　　width　：number&lt;br&gt;　　height　：number&lt;br&gt;　　byteSize　：number&lt;br&gt;　　createdAt　：number" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#2b5f8e;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="260" width="240" height="155" as="geometry" />
        </mxCell>
        <mxCell id="thumbnails" value="&lt;b&gt;thumbnails（一覧用画像）&lt;/b&gt;&lt;hr&gt;PK/FK　photoId　：string&lt;br&gt;　　image　：Blob（JPEG）&lt;br&gt;　　byteSize　：number" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#2b5f8e;fontSize=12;" vertex="1" parent="1">
