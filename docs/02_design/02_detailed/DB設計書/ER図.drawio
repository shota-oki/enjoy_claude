        <!-- 凡例 -->
        <mxCell id="legend" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;■ 青の実線：IndexedDB のオブジェクトストア（テーブル）&lt;br&gt;■ 灰色の破線：アプリ内の定数（DBには保存しない）&lt;br&gt;・PK＝主キー、FK＝参照するキー（IndexedDBに外部キー制約はなく、アプリ側で整合性を保つ）&lt;br&gt;・items.photoIds は写真の並び順を保持する（先頭が代表写真）&lt;br&gt;・settings は他のストアと関連を持たない" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#cccccc;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="470" width="570" height="115" as="geometry" />
        </mxCell>

