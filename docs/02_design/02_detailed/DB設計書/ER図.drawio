        <mxCell id="categories" value="&lt;b&gt;カテゴリ（アプリ内定数）&lt;/b&gt;&lt;hr&gt;PK　id　：string（tops 等）&lt;br&gt;　　name　：string&lt;br&gt;　　sortOrder　：number" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="colors" value="&lt;b&gt;ベースカラー（アプリ内定数）&lt;/b&gt;&lt;hr&gt;PK　id　：string（white 等）&lt;br&gt;　　name　：string&lt;br&gt;　　hex　：string&lt;br&gt;　　sortOrder　：number" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#888888;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="250" height="115" as="geometry" />
        </mxCell>

        <!-- オブジェクトストア -->
